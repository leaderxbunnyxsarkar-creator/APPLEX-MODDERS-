// Firebase Storage Rules template — replace YOUR_ADMIN_FIREBASE_UID.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "YOUR_ADMIN_FIREBASE_UID";
    }
    match /site-banners/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
  }
}
